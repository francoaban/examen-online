{
  "name": "examen-online",
  "version": "0.1.0",
  "description": "Plataforma de exámenes en línea con intento único, cronómetro del servidor y auditoría de foco.",
  "author": "Franco Emanuel Aban Tejerina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/francoaban/examen-online.git"
  },
  "private": false,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke.ts",
    "ai:check": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ai-check.ts",
    "test:unit": "tsx --test scripts/smoke-unit.ts lib/api/attempt-schemas.test.ts lib/csv.test.ts lib/exam/validators.test.ts lib/exam/question-import.test.ts lib/logger.test.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neon/ai-sdk-provider": "^1.6.0",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@next/env": "16.4.6",
    "ai": "^7.0.181",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "^3.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
