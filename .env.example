# ---------------------------------------------------------------------------
# Plantilla de variables de entorno. Copiala a .env y completá los valores.
# `neon deploy` completa solo las variables de Neon (base, Auth y AI Gateway).
# En Vercel se cargan en Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Neon Postgres (las escribe `neon deploy`) ------------------------------
# Usá la cadena "pooled" (host con -pooler).
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/nombre-db?sslmode=require
# Conexión directa (sin -pooler), recomendada para migraciones.
DATABASE_URL_UNPOOLED=

# --- Neon Auth (la escribe `neon deploy`) -----------------------------------
NEON_AUTH_BASE_URL=

# Secreto de cookies de la app (mínimo 32 caracteres). Generá uno con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# --- Aplicación -------------------------------------------------------------
# Emails con rol docente, separados por coma. Cada docente debe registrarse y
# verificar esa dirección antes de acceder al panel.
# Obligatoria en Vercel: si falta, nadie tendrá permisos docentes.
TEACHER_EMAILS=tu.correo@gmail.com

# Solo para probar cuentas ficticias @example.test con pnpm dev.
# No habilita emails sin verificar fuera de desarrollo.
ALLOW_UNVERIFIED_TEST_EMAILS=false

# --- Neon AI Gateway (opcional; las escribe `neon deploy`) ------------------
# Necesarias solo si usás lib/ai.ts. Requieren créditos de AI Gateway en Neon.
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
