# ---------------------------------------------------------------------------
# Copiá este archivo a .env.local y completá los valores.
# En Vercel se cargan como Environment Variables del proyecto.
# ---------------------------------------------------------------------------

# URL de Neon Managed Auth. `neon deploy` la agrega al archivo de entorno.
NEON_AUTH_BASE_URL=

# Secreto de cookies de la app (mínimo 32 caracteres). Generá uno con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# Neon (o cualquier Postgres). Usá la cadena "pooled" si está disponible.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Emails con rol docente, separados por coma. Cada docente debe registrarse y
# verificar esa dirección antes de acceder al panel.
# Obligatoria en Vercel: si falta, nadie tendrá permisos docentes.
TEACHER_EMAILS=tu.correo@gmail.com

# Solo para probar cuentas ficticias @example.test con pnpm dev.
# No habilita emails sin verificar fuera de desarrollo.
ALLOW_UNVERIFIED_TEST_EMAILS=false
