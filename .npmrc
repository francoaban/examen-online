# pnpm 11 bloquea los scripts de instalación por defecto.
# Los binarios nativos se habilitan en pnpm-workspace.yaml (allowBuilds).
#
# No fallar si alguna dependencia peer opcional no está presente (p. ej. sharp).
strict-peer-dependencies=false

# No exigir una versión exacta de Node definida en engines.
engine-strict=false
